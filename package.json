{
  "name": "quarry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:copy": "node tools/lint-copy.mjs",
    "engine-pin": "node tools/check-engine-blob.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run engine-pin && npm run test:lint && npm run lint:copy && npm run lint:tokens && npm run svelte-check && npm run test && npm run build",
    "lint:tokens": "node tools/lint-tokens.mjs src/style.css src/lib/Shell.svelte src/lib/Game.svelte src/lib/Sheets.svelte",
    "test:lint": "node tools/test-lint-tokens.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/qrcode": "^1.5.5",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.1"
  }
}
